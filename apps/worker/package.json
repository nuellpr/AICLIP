{
  "name": "clipforge-worker",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,env --exec ts-node src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); ['face_tracker.py','mediapipe_tracker.py','whisper_service.py'].forEach(f => { if(fs.existsSync('src/'+f)) fs.copyFileSync('src/'+f,'dist/'+f) })\"",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@clipforge/database": "workspace:*",
    "@clipforge/shared": "workspace:*",
    "@google/genai": "^2.12.0",
    "bullmq": "^6.0.2",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "openai": "^6.48.0",
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
