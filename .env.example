# Application URLs
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
WORKER_URL=http://localhost:3002

# Database
DATABASE_URL="file:./dev.db"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (Custom JWT secret)
AUTH_SECRET="super-secret-key-for-development-only-change-in-prod"

# AI Provider
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_ANALYSIS_MODEL="gpt-4o-mini"

# Google Gemini (for ClipForge Worker)
GEMINI_API_KEY=""

# AI Config (overrides ai-config.json)
AI_PROVIDER="google-gemini"
AI_BASE_URL=""
AI_MODEL="gemini-2.0-flash"

# CORS allowed origins (comma-separated, for production)
CORS_ORIGIN="*"

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage_data"

# Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=60
MAX_CLIPS_PER_PROJECT=10
FILE_RETENTION_DAYS=7

# Modes
DEMO_MODE=true
