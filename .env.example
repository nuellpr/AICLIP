# Application URLs
NODE_ENV=development
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WORKER_URL=http://localhost:3002

# Database
DATABASE_URL="file:./dev.db"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (Custom JWT secret) - ganti di production dengan string random 32+ char
AUTH_SECRET="super-secret-key-for-development-only-change-in-prod"

# Google OAuth 2.0 - WAJIB untuk login Google
# Dapatkan dari https://console.cloud.google.com/apis/credentials
# 1. Buat Project baru atau pilih existing
# 2. Aktifkan "Google Identity Services" & "Google OAuth consent screen"
# 3. Buat OAuth 2.0 Client ID (Application type: Web application)
# 4. Authorized JavaScript origins: http://localhost:3000, https://yourdomain.com
# 5. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google, https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Untuk production (Vercel/forgeai.web.id):
# GOOGLE_CLIENT_ID sama dengan NEXT_PUBLIC_GOOGLE_CLIENT_ID
# NEXT_PUBLIC_APP_URL harus = https://yourdomain.com (tanpa trailing slash)

# Dev fallback: izinkan decode JWT tanpa verifikasi tokeninfo.
# HANYA aktif jika NODE_ENV != production DAN nilai = true (keduanya wajib)
ALLOW_INSECURE_GOOGLE_AUTH=false

# AI Provider
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_ANALYSIS_MODEL="gpt-4o-mini"

# Google Gemini (for ClipForge Worker)
GEMINI_API_KEY=""

# AI Config (overrides ai-config.json)
AI_PROVIDER="google-gemini"
AI_BASE_URL=""
AI_MODEL="gemini-2.0-flash"

# CORS allowed origins (comma-separated, for production)
CORS_ORIGIN="*"

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage_data"

# Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=60
MAX_CLIPS_PER_PROJECT=10
FILE_RETENTION_DAYS=7

# Modes
DEMO_MODE=true

# Path overrides (opsional - default menunjuk ke struktur repo)
# PUBLIC_DIR="./apps/api/public"
# RENDERS_DIR="./apps/api/public/renders"
# WEB_RENDERS_DIR="./apps/web/public/renders"
# WORKER_DIR="./apps/worker"

# FFmpeg custom path (opsional)
# FFMPEG_PATH=""
# HOOK_FONT_PATH=""

# Email (Welcome Email via Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# Midtrans Payment Gateway
# https://dashboard.sandbox.midtrans.com / https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
